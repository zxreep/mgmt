# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/salespulse?retryWrites=true&w=majority
# Initial admin account (created/updated when the server starts)
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-long-secure-password
ADMIN_NAME=Sales Admin
# Use at least 32 random characters
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
PORT=5000
